<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="product_json_ld_schema" name="Product JSON-LD Schema">
        <t t-if="product">
            <t t-set="current_lang" t-value="lang or 'en_US'"/>
            <t t-set="localized_product" t-value="product.with_context(lang=current_lang)"/>
            <t t-set="images_list" t-value="product.get_jsonld_images()"/>
            <t t-set="price_info" t-value="product.get_jsonld_price_info()"/>
            <t t-set="product_type" t-value="product.get_jsonld_product_type()"/>
            <t t-set="google_product_category" t-value="product.get_jsonld_google_product_category()"/>
            <t t-set="website_base" t-value="website.get_base_url()"/>

            <script type="application/ld+json">
            {
                "@context": "https://schema.org/",
                "@type": "Product",

                "name": "<t t-out='product.jsonld_escape(localized_product.name)'/>"
                <t t-if="localized_product.description_sale or product_type or google_product_category or product.default_code or product.product_brand_id or product.upc or product.manufacturer_pref">,</t>

                <t t-if="localized_product.description_sale">
                    "description": "<t t-out='product.jsonld_escape(localized_product.description_sale)'/>"
                    <t t-if="product_type or google_product_category or product.default_code or product.product_brand_id or product.upc or product.manufacturer_pref">,</t>
                </t>

                <t t-if="product_type">
                    "category": "<t t-out='product.jsonld_escape(product_type)'/>"
                    <t t-if="google_product_category or product.default_code or product.product_brand_id or product.upc or product.manufacturer_pref">,</t>
                </t>

                <t t-if="google_product_category">
                    "google_product_category": "<t t-out='product.jsonld_escape(google_product_category)'/>"
                    <t t-if="product.default_code or product.product_brand_id or product.upc or product.manufacturer_pref">,</t>
                </t>

                <t t-if="product.default_code">
                    "sku": "<t t-out='product.jsonld_escape(product.default_code)'/>"
                    <t t-if="product.product_brand_id or product.upc or product.manufacturer_pref">,</t>
                </t>

                <t t-if="product.product_brand_id and product.product_brand_id.name">
                    "brand": {
                        "@type": "Brand",
                        "name": "<t t-out='product.jsonld_escape(product.product_brand_id.with_context(lang=current_lang).name)'/>"
                    }
                    <t t-if="product.upc or product.manufacturer_pref">,</t>
                </t>

                <t t-if="product.upc">
                    "gtin": "<t t-out='product.jsonld_escape(product.upc)'/>"
                    <t t-if="product.manufacturer_pref">,</t>
                </t>

                <t t-if="not product.upc and product.manufacturer_pref">
                    "mpn": "<t t-out='product.jsonld_escape(product.manufacturer_pref)'/>"
                    <t t-if="product.weight > 0 or images_list">,</t>
                </t>

                "image": [
                    <t t-foreach="images_list" t-as="img_url" t-foreach-index="img_url_index">
                        <t t-if="img_url_index > 0">,</t>"<t t-out='img_url'/>"
                    </t>
                ]
                <t t-if="product.weight > 0">,</t>

                <t t-if="product.weight > 0">
                "shippingWeight": {
                    "@type": "QuantitativeValue",
                    "value": <t t-esc='product.weight'/>,
                    "unitCode": "KGM"
                },
                </t>

                "offers": {
                    "@type": "Offer",
                    "url": "<t t-out='website_base + localized_product.website_url'/>",
                    "priceCurrency": "<t t-out='price_info[\"currency\"]'/>",
                    "price": <t t-out='price_info["price"]'/>,
                    "itemCondition": "https://schema.org/NewCondition",
                    "availability": "https://schema.org/InStock"
                    <t t-if="website.company_id.country_id">
                        ,
                        "areaServed": {
                            "@type": "Country",
                            "name": "<t t-out='product.jsonld_escape(website.company_id.country_id.name)'/>"
                        }
                    </t>
                }
            }
            </script>
        </t>
    </template>

    <template id="inject_json_ld_into_product_page" inherit_id="website_sale.product">
        <xpath expr="//div[@id='wrap']" position="inside">
            <t t-call="website_sale_jsonld_schema.product_json_ld_schema"/>
        </xpath>
    </template>

</odoo>
