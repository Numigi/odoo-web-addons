<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Modal Template for Company Switcher -->
    <template id="visual_company_switcher_modal" name="Visual Company Switcher Modal">
        <div class="modal fade" id="visualCompanySwitcherModal" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title">Sélecteur de Compagnie</h4>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&amp;times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="company-switcher-toolbar mb-3">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="multiSelectMode"/>
                                        <label class="form-check-label" for="multiSelectMode">
                                            Mode sélection multiple
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-6 text-right">
                                    <button type="button" class="btn btn-primary" id="applySelection" style="display: none;">
                                        Appliquer la sélection
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div id="orgchart-container" class="text-center">
                            <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="sr-only">Chargement...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Fermer</button>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!-- Systray Menu Template -->
    <template id="SystrayCompanySwitcher" name="Systray Company Switcher">
        <li class="dropdown">
            <a href="#" class="dropdown-toggle o_visual_company_switcher" title="Sélecteur de Compagnie Visuel">
                <i class="fa fa-sitemap visual-company-switcher-icon"/>
            </a>
        </li>
    </template>

    <!-- Company Node Template for OrgChart -->
    <template id="company_node_template" name="Company Node Template">
        <div class="company-node">
            <div class="company-checkbox" style="display: none;">
                <input type="checkbox" class="company-select"/>
            </div>
            <div class="company-logo" t-if="logo">
                <img t-att-src="logo" alt="Logo" class="img-fluid"/>
            </div>
            <div class="company-name" t-esc="name"/>
            <div class="company-status" t-if="current">
                <span class="badge badge-success">Active</span>
            </div>
        </div>
    </template>
</odoo>